{
  "manifest_version": 3,
  "name": "Cart to Shelf",
  "version": "1.0.0",
  "description": "Move books from your Amazon cart, wish lists, and Save for Later onto your Goodreads Want to Read shelf.",
  "background": {
    "service_worker": "src/background.js",
    "scripts": [
      "src/background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Cart to Shelf",
    "default_icon": {
      "16": "src/icons/icon16.png",
      "32": "src/icons/icon32.png",
      "48": "src/icons/icon48.png",
      "128": "src/icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "downloads",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://*.amazon.com/*",
    "https://*.goodreads.com/*",
    "https://openlibrary.org/*",
    "https://www.googleapis.com/*"
  ],
  "icons": {
    "16": "src/icons/icon16.png",
    "32": "src/icons/icon32.png",
    "48": "src/icons/icon48.png",
    "128": "src/icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "cart-to-shelf@burba.email",
      "strict_min_version": "121.0"
    }
  }
}
